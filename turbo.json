{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": { "persistent": true, "cache": false },
    "backend#dev-ready": { "cache": false },
    "frontend#dev": {
      "dependsOn": ["backend#dev-ready"],
      "persistent": true,
      "cache": false
    },
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "dist/**"] }
  }
}